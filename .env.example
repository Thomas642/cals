# Cle API Anthropic (pay-as-you-go), lue uniquement par le backend. Laisser vide pour desactiver l'IA.
ANTHROPIC_API_KEY=
# Modele IA (GDD v2 : claude-haiku-4-5)
CLAUDE_MODEL=claude-haiku-4-5
# Port HTTP expose par le service frontend (nginx)
CALS_HTTP_PORT=8080
# Jeton du tunnel Cloudflare Zero Trust (profil docker compose "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
