# Assistant IA : renseigner UNE cle (lue uniquement par le backend). Vide = assistant desactive.
# Google Gemini (fournisseur par defaut) : cle a creer sur https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Modeles essayes si le principal est indisponible (separes par des virgules)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.8-flash
# Anthropic Claude (alternative) : https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# Forcer un fournisseur si les deux cles sont presentes : gemini | anthropic
AI_PROVIDER=
# Port HTTP local du frontend (nginx du conteneur)
CALS_HTTP_PORT=8080
# Jeton du tunnel Cloudflare Zero Trust (profil docker compose "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
