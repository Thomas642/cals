# Taille maximale d'une video importee, en Go
MAX_VIDEO_GB=20
# Conversion automatique des videos illisibles par les navigateurs (ffmpeg) : on | off
VIDEO_PROCESSING=on
# Reglages x264 de la conversion : preset plus lent = fichier plus petit mais conversion plus longue
X264_PRESET=veryfast
X264_CRF=20
# Port HTTP local du frontend (nginx du conteneur)
CALS_HTTP_PORT=8080
# Jeton du tunnel Cloudflare Zero Trust (profil docker compose "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
