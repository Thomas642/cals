# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://familytracker:CHANGE_ME@localhost:5432/familytracker

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=30d

# ── Web Push (generate with: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── Upload ───────────────────────────────────────────────
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=5

# ── Frontend URL (for CORS) ───────────────────────────────
FRONTEND_URL=https://tracker.example.com
