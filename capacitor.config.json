{
  "appId": "com.familytracker.app",
  "appName": "FamilyTracker",
  "webDir": "frontend",
  "server": {
    "url": "https://famille.gameone-val.com",
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "BackgroundGeolocation": {
      "notificationTitle": "FamilyTracker actif",
      "notificationText": "Partage de position en cours…",
      "notificationIconColor": "#3b82f6",
      "stopsOnTerminate": false,
      "startOnBoot": false,
      "requestPermissions": true,
      "distanceFilter": 10
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": false,
      "backgroundColor": "#070c18",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#6366f1"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#070c18",
      "overlaysWebView": false
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
